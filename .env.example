# ---------------------------------------------------------------------------
# EDH Tracker — environment variables
# Copy to `.env` for local dev. On Netlify set these in Site settings > Env vars.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (Railway provides this as DATABASE_URL).
# Railway public URL example:
#   postgresql://postgres:PASSWORD@containers-us-west-1.railway.app:6543/railway
# For local dev with Docker:
#   postgresql://postgres:postgres@localhost:5432/edh
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/edh"

# Single-user auth. This is the password you type on the login screen.
APP_PASSWORD="change-me-to-something-long"

# Secret used to sign the session cookie (JWT). Generate with:
#   openssl rand -base64 48
AUTH_SECRET="generate-a-long-random-secret-at-least-32-chars"

# Optional: number of days a login session stays valid (default 30).
SESSION_DAYS="30"
